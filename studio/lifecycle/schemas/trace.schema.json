{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lentera-pudar.internal/studio/lifecycle/trace.schema.json",
  "title": "Trace",
  "description": "Execution provenance and observed-context record schema linked to a Work Order",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "workOrderId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "commit"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "projectId",
    "workOrderId",
    "actor",
    "timestamp",
    "repository",
    "observations",
    "evidenceRefs"
  ],
  "additionalProperties": false
}
